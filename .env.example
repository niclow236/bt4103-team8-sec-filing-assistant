# Copy this file to .env and fill in your own values.
# .env is git-ignored, so nothing machine-specific gets committed.

# Required. The SEC asks every automated request to identify itself with a name
# and a contact email, and blocks traffic that does not. edgartools reads this
# variable and sends it as the User-Agent header on every EDGAR request.
EDGAR_IDENTITY=Your Name your-email@example.com

# Optional. Where edgartools keeps its HTTP cache. Defaults to your home
# directory if left unset.
# EDGAR_CACHE_DIR=.cache/edgar

# Answer generation. Everything runs locally through Ollama, so there are no
# API keys to set. Install Ollama from https://ollama.com/download, then pull
# the model: ollama pull llama3.2:3b

# Which model answers, as Ollama names it. Unset means DEFAULT_MODEL in
# src/rag/constants.py (llama3.2:3b). Pull any model you set here first.
# LLM_MODEL=llama3.1:8b

# Where Ollama is listening. Unset means Ollama's default on this machine.
# LLM_BASE_URL=http://127.0.0.1:11434

# How many of the model's layers go on the GPU. Unset lets Ollama decide, which
# is right for a capable GPU or a Mac. On a laptop with a small GPU (2 GB, such
# as an MX450), set 0: splitting the model across CPU and GPU there was more
# than four times slower than running it on the CPU alone.
# LLM_NUM_GPU=0
