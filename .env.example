# Copy this file to .env and fill in your own values.
# .env is git-ignored, so your real keys never get committed.

# Required. The SEC asks every automated request to identify itself with a name
# and a contact email, and blocks traffic that does not. edgartools reads this
# variable and sends it as the User-Agent header on every EDGAR request.
EDGAR_IDENTITY=Your Name your-email@example.com

# Optional. Where edgartools keeps its HTTP cache. Defaults to your home
# directory if left unset.
# EDGAR_CACHE_DIR=.cache/edgar

# LLM provider: uncomment and fill in whichever you end up using.
# Leave all commented if you run a fully local open-source model.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# HUGGINGFACEHUB_API_TOKEN=

# Local model server (if you self-host, e.g. Ollama or LM Studio).
# LLM_BASE_URL=http://localhost:11434
