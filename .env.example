# Copy this file to .env and fill in your own values.
# .env is git-ignored, so your real keys never get committed.

# Required. The SEC asks every automated request to identify itself with a name
# and a contact email, and blocks traffic that does not. edgartools reads this
# variable and sends it as the User-Agent header on every EDGAR request.
EDGAR_IDENTITY=Your Name your-email@example.com

# Optional. Where edgartools keeps its HTTP cache. Defaults to your home
# directory if left unset.
# EDGAR_CACHE_DIR=.cache/edgar

# LLM provider. Leave everything here commented to run fully local: with no
# ANTHROPIC_API_KEY set, the generator uses the Ollama server below.
#
# Which provider answers: "anthropic" (hosted) or "ollama" (local). Unset means
# anthropic when a key is present and ollama when not.
# LLM_PROVIDER=ollama
#
# Which model, in the provider's own name. Unset means the provider's default in
# src/rag/constants.py (claude-opus-5 hosted, llama3.1:8b local).
# LLM_MODEL=llama3.1:8b
#
# The hosted API key. Optional: nothing needs it if you run local.
# ANTHROPIC_API_KEY=

# Local model server (Ollama). Unset means Ollama's default port on this machine.
# LLM_BASE_URL=http://localhost:11434
